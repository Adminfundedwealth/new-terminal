# Leave empty in local Vite development to use the same-origin proxy; set the deployed Terminal OS URL outside local development.
VITE_TERMINAL_OS_URL=
# ══════════════════════════════════════════════════════════
# Mr. Chartist — Options Terminal | Environment Variables
# ══════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚡ QUICK START: Just run `npm run dev` — no env vars needed!
#    The app works with TradingView + NSE data out of the box.
#    Add Dhan credentials below for premium real-time data.
#
# ══════════════════════════════════════════════════════════

# ── TERMINAL SUPABASE — FRONTEND ──
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── TERMINAL SUPABASE — BACKEND ONLY ──
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── DHAN BROKER API (Recommended — Primary Data Source) ──
# Sign up at https://dhan.co and create an API app at https://dhanhq.co/docs/v2/
# Dhan provides: Real-time Option Chain, Greeks, WebSocket Live Ticks
#
# DHAN_CLIENT_ID=your_dhan_client_id
# DHAN_ACCESS_TOKEN=your_dhan_access_token

# ── PROXY SERVER PORT (Optional) ──
# Default: 4002. Change only if port 4002 is already in use.
# PROXY_PORT=4002

# ── VITE PROXY URL (Optional) ──
# Default: http://localhost:4002. Change only for custom proxy setups.
# VITE_PROXY_URL=http://localhost:4002

# ── AUTHENTICATED REALTIME SERVICE (Optional locally, required in production) ──
# Local default: ws://localhost:4012/ws. Production uses the dedicated always-on Node service.
# VITE_REALTIME_URL=wss://your-realtime-service.example.com/ws

# ── KITE CONNECT OAUTH (PROXY SERVER ONLY) ──
# These values are read only by proxy-server.mjs and never sent to browser JavaScript.
# KITE_API_KEY=your_kite_api_key
# KITE_API_SECRET=your_kite_api_secret
# KITE_REDIRECT_URL=http://localhost:4001/api/kite/callback
