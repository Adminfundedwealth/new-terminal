<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^auth/sso/?$ sso-proxy.php?route=sso [QSA,L]
  RewriteRule ^auth/sso/exchange/?$ sso-proxy.php?route=exchange [QSA,L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
