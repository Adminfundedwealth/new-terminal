<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^auth/sso/?$ sso-proxy.php?route=sso [QSA,L]
  RewriteRule ^auth/sso/store/?$ sso-proxy.php?route=store [QSA,L]
  RewriteRule ^auth/sso/exchange/?$ sso-proxy.php?route=exchange [QSA,L]
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^assets/ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  <FilesMatch "^[A-Za-z0-9._-]+-[A-Za-z0-9_-]{8,}\.(js|css|woff2)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
